# ============================================
# Discord Bot Configuration
# ============================================
# Your Discord Bot Token (from Discord Developer Portal)
DISCORD_TOKEN=your_discord_bot_token_here

# Optional: Guild IDs for faster slash command registration (comma-separated)
# Leave empty for global commands (takes up to 1 hour to propagate)
# Example: DISCORD_GUILD_IDS=123456789,987654321
DISCORD_GUILD_IDS=

# Your Discord User ID (for the "Developed by Daly ❤️" footer)
# Right-click your profile in Discord > Copy User ID (requires Developer Mode)
DEVELOPER_USER_ID=your_discord_user_id

# ============================================
# Lavalink Configuration
# ============================================
# Password for Lavalink server authentication
LAVALINK_PASSWORD=youshallnotpass

# ============================================
# Spotify API Credentials
# ============================================
# Get these from: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# ============================================
# YouTube Cipher Configuration (Optional)
# ============================================
# Remote cipher server URL - handles YouTube signature decryption
# Default uses the public instance (free, no setup required)
# For self-hosted: uncomment yt-cipher service in docker-compose.yml
# and set this to http://yt-cipher:8001/
YT_CIPHER_URL=https://cipher.kikkia.dev/

# Optional: identifies your bot in cipher server logs
YT_CIPHER_USER_AGENT=delify-bot
 
# --------------------------------------------
# YouTube OAuth (optional)
# If you prefer OAuth, follow the README steps to obtain a refresh token.
# Use a burner account — do not use your primary Google account.
YOUTUBE_OAUTH_ENABLED=false
YOUTUBE_OAUTH_REFRESH_TOKEN=

# ============================================
# Lyrics Configuration (Optional)
# ============================================
# RapidAPI credentials for Genius Song Lyrics API
# Get these from: https://rapidapi.com/Glavier/api/genius-song-lyrics1
RAPIDAPI_KEY=
RAPIDAPI_HOST=genius-song-lyrics1.p.rapidapi.com

# ============================================
# Bot Behavior
# ============================================
# Inactivity timeout in seconds (bot leaves voice after this duration of no playback)
INACTIVITY_TIMEOUT=30