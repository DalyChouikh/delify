+import org.apache.http.client.utils.URIBuilder;
@@ -249 +250,33 @@
-    return new FormatWithUrl(format, resolvedUrl);
+    FormatWithUrl primary = new FormatWithUrl(format, resolvedUrl);
+    try {
+      probeMediaUrl(httpInterface, primary.signedUrl);
+      return primary;
+    } catch (IOException primaryFailure) {
+      if (Thread.currentThread().isInterrupted()) {
+        throw primaryFailure;
+      }
+      FormatWithUrl alternate = primary.getFallback();
+      if (alternate == null) {
+        throw primaryFailure;
+      }
+      log.warn("YouTube audio CDN {} failed; trying alternate {}",
+          primary.signedUrl.getHost(), alternate.signedUrl.getHost());
+      try {
+        probeMediaUrl(httpInterface, alternate.signedUrl);
+        return alternate;
+      } catch (IOException alternateFailure) {
+        alternateFailure.addSuppressed(primaryFailure);
+        throw alternateFailure;
+      }
+    }
+  }
+
+  private void probeMediaUrl(HttpInterface httpInterface, URI url) throws IOException {
+    HttpGet request = new HttpGet(url);
+    request.setHeader("Range", "bytes=0-0");
+    try (CloseableHttpResponse response = httpInterface.execute(request)) {
+      int status = response.getStatusLine().getStatusCode();
+      if (status < 200 || status >= 300) {
+        throw new IOException("Audio CDN returned HTTP " + status);
+      }
+    }
